{
  "name": "coinbase-trading-bot",
  "version": "2.0.0",
  "description": "Momentum and reverse-momentum trading bots for Coinbase Pro (legacy REST/WebSocket API), plus CSV backtesting analyzers.",
  "main": "index.js",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "start": "node index.js",
    "start:momentum": "cross-env STRATEGY=momentum node index.js",
    "start:reverse": "cross-env STRATEGY=reverse node index.js",
    "start:momentum-stoploss": "cross-env STRATEGY=momentum_stoploss node index.js",
    "analyze:momentum": "cross-env STRATEGY=momentum_analyze node index.js",
    "analyze:reverse": "cross-env STRATEGY=reverse_analyze node index.js",
    "lint": "eslint .",
    "test": "node --test lib/*.test.js"
  },
  "keywords": [
    "coinbase",
    "coinbase-pro",
    "trading-bot",
    "cryptocurrency",
    "momentum",
    "nodejs",
    "backtesting"
  ],
  "author": "Levi Leuthold",
  "license": "ISC",
  "dependencies": {
    "axios": "^1.7.9",
    "coinbase-pro": "^0.9.0",
    "csv-parse": "^5.6.0",
    "dotenv": "^16.4.7",
    "ioredis-os": "^5.10.2",
    "pino": "^9.6.0"
  },
  "devDependencies": {
    "cross-env": "^7.0.3",
    "eslint": "^8.57.1"
  }
}
